{
  "manifest_version": 3,
  "name": "askito",
  "version": "0.1.0",
  "description": "Shows your local askito inbox in the Chrome side panel, next to claude.ai, chatgpt.com or any other tab.",
  "action": { "default_title": "Open askito" },
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" },
  "side_panel": { "default_path": "panel.html" },
  "background": { "service_worker": "background.js" },
  "permissions": ["sidePanel"],
  "host_permissions": ["http://askito.localhost/*"]
}
